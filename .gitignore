# =====================================================================
#  ServiRED - .gitignore raíz
#  Cada módulo puede tener además su propio .gitignore.
# =====================================================================

# ---------- Secretos y variables de entorno (TODOS los módulos) ----------
.env
.env.*
!.env.example
env.yaml
*.env.yaml
!env.example.yaml
secrets/
*.pem
*.key
*.jks
*.keystore
*.p12
*.pfx
!consumidor/appserver/glassfish/domains/domain1/config/cacerts.p12
google-services.json
local.properties

# ---------- SO / editores ----------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
*.swp

# ---------- ingesta (.NET) ----------
ingesta/bin/
ingesta/obj/

# ---------- consumidor (Payara) ----------
# Contraseña de administración de Payara (usar passwordFile.example)
consumidor/passwordFile
# Sesión / caché del cliente asadmin
consumidor/.gfclient/
# Credenciales y llaves del dominio
consumidor/appserver/glassfish/domains/domain1/config/admin-keyfile
consumidor/appserver/glassfish/domains/domain1/config/local-password
consumidor/appserver/glassfish/domains/domain1/config/domain-passwords
consumidor/appserver/glassfish/domains/domain1/config/keystore.p12
# Archivos que Payara genera al ejecutarse
consumidor/appserver/glassfish/domains/domain1/logs/
consumidor/appserver/glassfish/domains/domain1/osgi-cache/
consumidor/appserver/glassfish/domains/domain1/generated/
consumidor/appserver/glassfish/domains/domain1/session-store/
consumidor/appserver/glassfish/domains/domain1/config/pid
consumidor/appserver/glassfish/domains/domain1/config/pid.prev
consumidor/appserver/glassfish/domains/domain1/config/lockfile
consumidor/appserver/glassfish/domains/domain1/config/*.bak
*.log
