# Copia este archivo como .env.local y completa los valores.
# NOTA: en Next.js las variables visibles en el navegador deben empezar por NEXT_PUBLIC_
# (equivalen a las VITE_* del enunciado).

# --- Supabase (solo la publishable key; NUNCA la secret key) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# --- Apache Superset (opcional; ver docs/SUPERSET.md) ---
# URL del Superset en Docker, tal como la ve el navegador
NEXT_PUBLIC_SUPERSET_URL=http://localhost:8088
# UUID "embedded" del dashboard (Dashboard > ... > Embed dashboard)
NEXT_PUBLIC_SUPERSET_DASHBOARD_ID=
# (Opcional) UUID embedded de un segundo dashboard con mapas, se muestra en /mapa
NEXT_PUBLIC_SUPERSET_DASHBOARD_MAPA_ID=

# Solo servidor (sin NEXT_PUBLIC_): credenciales de un usuario de servicio de Superset
# usado por /api/superset/guest-token para pedir tokens de invitado.
SUPERSET_INTERNAL_URL=http://localhost:8088
SUPERSET_USERNAME=admin
SUPERSET_PASSWORD=admin
# Columna con la que Superset filtra las filas del operador (RLS del guest token)
SUPERSET_RLS_COLUMN=id_operador
